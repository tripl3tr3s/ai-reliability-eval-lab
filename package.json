{
  "name": "ai-reliability-eval-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "reliability-lab": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "benchmark": "tsx src/cli.ts run",
    "benchmark:interactive": "tsx src/cli.ts run --interactive",
    "benchmark:mock": "vitest run tests/experiment.test.ts",
    "check": "pnpm lint && pnpm type-check && pnpm test:coverage && pnpm dataset:validate && pnpm config:validate",
    "config:validate": "tsx src/cli.ts validate-config",
    "dataset:validate": "tsx src/cli.ts validate-dataset",
    "eval": "tsx src/cli.ts run",
    "lint": "eslint .",
    "report": "tsx src/cli.ts report",
    "report:replay": "vitest run tests/report-baseline.test.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm dataset:validate && pnpm config:validate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.65.0",
    "@clack/prompts": "1.7.0",
    "efos-risk-graph": "0.3.0",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.24.6"
  },
  "optionalDependencies": {
    "@langfuse/otel": "4.0.0",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/sdk-trace-node": "2.1.0"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@types/node": "22.18.0",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.34.0",
    "tsx": "4.23.12",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@10.15.0"
}
